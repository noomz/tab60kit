{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"types": ["bun"],
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["core/**/*.ts", "web/**/*.ts", "testing/**/*.ts", "tools/**/*.ts", "lab/**/*.ts", "probes/policy.test.ts", "probes/boundaries.ts"]
}
